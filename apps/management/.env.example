# apps/management — template variabili ambiente della seconda app Next (gestionale).
#
# Copiare in apps/management/.env.local e compilare i valori effettivi
# prima di eseguire `pnpm dev:management` o `pnpm build:management`.
#
# NESSUN VALORE REALE: questo file e' versionato e non deve mai contenere segreti.
# Le variabili server-only dello storefront (SUPABASE_SECRET_KEY, STRIPE_*, RESEND_*, ecc.)
# non appartengono a questa app e non devono essere aggiunte qui.

# ── Surface ────────────────────────────────────────────────────────────────────
# Fisso: identifica l'artifact gestionale. Non modificare.
# Fonte: apps/management/src/lib/supabase/env.ts:13, packages/runtime-contract/src/index.ts:41
NEXT_PUBLIC_APP_SURFACE=management

# ── Supabase (valori pubblici — browser-safe) ──────────────────────────────────
# URL del progetto Supabase condiviso.
# Formato remoto: https://<ref>.supabase.co
# Formato locale (stack Supabase avviato con pnpm db:start): http://localhost:54421
# Fonte: apps/management/src/lib/supabase/env.ts:14, packages/runtime-contract/src/index.ts:103-125
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Publishable key del progetto Supabase (prefisso obbligatorio: sb_publishable_).
# Non usare service-role, anon-JWT legacy o qualsiasi chiave con prefisso diverso.
# In CI viene accettata la chiave fittizia: ci-publishable-key
# Fonte: apps/management/src/lib/supabase/env.ts:20-21
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Ref del progetto Supabase atteso (slug lowercase, es. abcdefghijkl).
# Usato per verificare che l'URL corrisponda al progetto autorizzato prima
# di costruire qualsiasi client. In locale impostare: local
# Fonte: packages/runtime-contract/src/index.ts:74-78, 95-126
NEXT_PUBLIC_EXPECTED_SUPABASE_PROJECT_REF=<ref>

# ── Origini ─────────────────────────────────────────────────────────────────────
# Origine HTTPS di questa app gestionale (es. https://gestionale.example.com).
# Deve essere un'origine pulita: schema + host, niente path, query, hash o credenziali.
# Obbligatoria quando NEXT_PUBLIC_APP_SURFACE=management.
# Fonte: packages/runtime-contract/src/index.ts:70-73
MANAGEMENT_ORIGIN=https://<gestionale-dominio>

# Origine dello storefront Gear Drop. Default nel codice: https://geardropshop.it
# Esplicitare in locale per evitare dipendenze da valori impliciti nelle origini.
# Fonte: packages/runtime-contract/src/index.ts:84
STOREFRONT_ORIGIN=https://geardropshop.it

# ── Modalita' operativa ─────────────────────────────────────────────────────────
# Modalita' del gestionale. Valori: read_only | active. Default nel codice: read_only
# Mantenere read_only durante l'intera fase di fondazione (Task 5 non completato).
# Fonte: packages/runtime-contract/src/index.ts:64-65
MANAGEMENT_MODE=read_only

# Comportamento del pannello /admin legacy nel deploy storefront.
# Valori: enabled | redirect. Default nel codice: enabled
# Non impostare redirect finche' apps/management non dispone di auth e MFA completi.
# Fonte: packages/runtime-contract/src/index.ts:67-68
LEGACY_ADMIN_MODE=enabled
