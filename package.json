{
  "name": "geardrop",
  "version": "1.0.0",
  "private": true,
  "description": "GEAR//DROP - store Beyblade X per la community italiana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config playwright.config.ts",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local supabase/tests",
    "db:test:upgrades": "tsx scripts/test-supabase-upgrades.ts",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "seed:supabase": "tsx scripts/generate-supabase-seed.ts",
    "shots": "playwright test --config playwright.shots.config.ts",
    "assets": "python scripts/build-assets.py",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "@vercel/analytics": "2.0.1",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.42.2",
    "lucide-react": "1.24.0",
    "marked": "18.0.6",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.34.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.0",
    "eslint-config-next": "16.2.10",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.13.1"
}
