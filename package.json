{
  "name": "geardrop",
  "version": "1.0.0",
  "private": true,
  "description": "GEAR//DROP - store Beyblade X per la community italiana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
