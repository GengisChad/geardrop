# GEAR//DROP environment. Copy to .env.local for local work; set the same keys in Vercel.
#
# With COMMERCE_PROVIDER unset (or "mock") the app runs entirely offline against
# src/data/catalog.ts — no Supabase project, no network, and the unit tests stay green.

# Which commerce backend the server uses: mock | supabase. Server-only, never NEXT_PUBLIC_.
COMMERCE_PROVIDER=mock

# Supabase project (Project Settings → API). Required only when COMMERCE_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key. Used solely to create guest orders through create_order.
# Never prefix it with NEXT_PUBLIC_ and never import it from a Client Component.
SUPABASE_SECRET_KEY=sb_secret_...
