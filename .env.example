# Local Supabase values are printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=

# Keep the offline-safe mock provider until the Supabase catalog gate is approved.
COMMERCE_PROVIDER=mock
CONTENT_PROVIDER=mock

# Used only by the documented one-shot owner bootstrap procedure.
GEARDROP_OWNER_EMAILS=

# Server-only. Stripe secret key of the seller-of-record account (sk_test_... locally).
STRIPE_SECRET_KEY=
# Server-only. Signing secret of the https://<site>/api/stripe/webhook endpoint (whsec_...),
# subscribed to checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# Server-only. Resend API key for order emails; without it orders are still recorded.
RESEND_API_KEY=
# Sender and owner inbox for order emails. Until the domain is verified on Resend, keep the
# shared onboarding sender, which only delivers to the Resend account's own email.
ORDER_EMAIL_FROM=GEAR//DROP Ordini <onboarding@resend.dev>
ORDER_NOTIFICATION_EMAIL=infogeardrop@gmail.com
# Set to true once the domain is verified to also email the buyer a confirmation.
ORDER_CUSTOMER_EMAILS=false
# Keep the mock adapter until the Stripe checkout is built and verified.
PAYMENTS_PROVIDER=mock
