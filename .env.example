# Local Supabase values are printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Select one independently deployed surface. Keep legacy /admin active on the storefront.
NEXT_PUBLIC_APP_SURFACE=storefront
MANAGEMENT_MODE=read_only
MANAGEMENT_ORIGIN=
STOREFRONT_ORIGIN=https://geardropshop.it
NEXT_PUBLIC_EXPECTED_SUPABASE_PROJECT_REF=
LEGACY_ADMIN_MODE=enabled

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=

# The company whose public shop this deployment serves (slug in public.organizations).
# It must have storefront_public = true; empty means geardrop.
NEXT_PUBLIC_STOREFRONT_ORGANIZATION=geardrop

# Keep the offline-safe mock provider until the Supabase catalog gate is approved.
COMMERCE_PROVIDER=mock
CONTENT_PROVIDER=mock

# Used only by the documented one-shot owner bootstrap procedure.
GEARDROP_OWNER_EMAILS=

# Server-only. Stripe secret key of the seller-of-record account (sk_test_... locally).
STRIPE_SECRET_KEY=
# Server-only. Signing secret of the https://<site>/api/stripe/webhook endpoint (whsec_...),
# subscribed to checkout.session.completed, checkout.session.async_payment_succeeded and charge.refunded.
STRIPE_WEBHOOK_SECRET=

# Server-only. Anthropic key for the pricing agent and the assistant; without it they stay off.
ANTHROPIC_API_KEY=
# Optional: model of the assistant (default claude-sonnet-5; claude-opus-5-5 answers better, costs more).
COPILOT_MODEL=
# Server-only. Fine-grained GitHub token, this repository only, for the assistant's work on the
# site's code (docs/operations/assistant-code-agent.md); without it the code cards stay off.
GITHUB_ASSISTANT_TOKEN=
GITHUB_ASSISTANT_REPO=

# Server-only. Resend API key for order emails; without it orders are still recorded.
RESEND_API_KEY=
# Sender and owner inbox for order emails. Until the domain is verified on Resend, keep the
# shared onboarding sender, which only delivers to the Resend account's own email.
ORDER_EMAIL_FROM=GEAR//DROP Ordini <onboarding@resend.dev>
ORDER_NOTIFICATION_EMAIL=infogeardrop@gmail.com
# Set to true once the domain is verified to also email the buyer a confirmation.
ORDER_CUSTOMER_EMAILS=false
# Keep the mock adapter until the Stripe checkout is built and verified.
PAYMENTS_PROVIDER=mock

# Server-only. InPost Global API of the shop's merchant account (merchant.inpost-group.com):
# OAuth client id and secret, and the organization id shown in the merchant portal. Without the
# id and secret the checkout falls back to a typed Locker and the admin cannot create shipments.
INPOST_CLIENT_ID=
INPOST_CLIENT_SECRET=
INPOST_ORGANIZATION_ID=
# production, or stage for InPost's sandbox (separate credentials).
INPOST_ENV=production
# Sender phone InPost requires on every shipment (E.164, e.g. +39...). The sender name is fixed
# in code as "Gear Drop Shop".
INPOST_SENDER_PHONE=
# Shared HMAC secret of the InPost tracking webhook (/api/inpost/webhook), once InPost turns it on.
INPOST_WEBHOOK_SECRET=
# Vercel Cron sends it as a Bearer token to /api/cron/inpost-tracking (daily delivery check).
CRON_SECRET=
