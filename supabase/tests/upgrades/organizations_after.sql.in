-- Run by scripts/test-supabase-upgrades.ts after organizations_before.sql.in has populated the
-- pre-organization schema and every later migration has been applied on top of it.
begin;
select plan(14);

select results_eq(
  $$select o.slug, count(f.feature)::integer, bool_and(not f.enabled)
    from public.organizations o join public.organization_management_features f on f.organization_id=o.id
    group by o.slug order by o.slug$$,
  $$values ('geardrop'::text,7,true), ('oryvenne'::text,7,true)$$,
  'populated upgrade adds all seven disabled management flags to both organizations'
);

create function pg_temp.rows_outside_geardrop(p_table text)
returns bigint
language plpgsql
as $$
declare
  outside bigint;
begin
  execute format(
    'select count(*) from public.%I where organization_id is distinct from (select id from public.organizations where slug = %L)',
    p_table, 'geardrop'
  ) into outside;
  return outside;
end;
$$;

select is_empty(
  $$
    select target
    from unnest(array[
      'categories', 'products', 'bundles', 'coupons', 'promotions', 'orders', 'customer_profiles',
      'inventory_movements', 'restock_requests', 'shipping_methods', 'media_assets', 'content_pages',
      'homepage_sections', 'navigation_menus', 'footer_columns', 'social_links',
      'storefront_daily_events', 'coupon_redemptions', 'order_items', 'bundle_items',
      'product_relations', 'product_images', 'coupon_products', 'promotion_categories',
      'homepage_section_products'
    ]) as target
    where pg_temp.rows_outside_geardrop(target) > 0
  $$,
  'every existing business row belongs to Gear Drop'
);

select results_eq(
  $$
    select (select count(*) from public.products)::integer, (select count(*) from public.product_images)::integer,
      (select count(*) from public.bundle_items)::integer, (select count(*) from public.order_items)::integer,
      (select count(*) from public.inventory_movements)::integer, (select count(*) from public.product_specs)::integer,
      (select count(*) from public.navigation_items)::integer, (select count(*) from public.footer_items)::integer
  $$,
  $$values (2, 2, 2, 1, 1, 1, 1, 1)$$,
  'no row is lost or duplicated by the upgrade'
);

select results_eq(
  $$
    select member.user_id::text, organization.slug, member.role::text, member.active
    from public.organization_members as member
    join public.organizations as organization on organization.id = member.organization_id
    where member.user_id::text like '00000000-0000-0000-0000-00000000a00%'
    order by member.user_id, organization.slug
  $$,
  $$values
    ('00000000-0000-0000-0000-00000000a001', 'geardrop', 'owner', true),
    ('00000000-0000-0000-0000-00000000a001', 'oryvenne', 'owner', true),
    ('00000000-0000-0000-0000-00000000a002', 'geardrop', 'owner', true),
    ('00000000-0000-0000-0000-00000000a002', 'oryvenne', 'owner', true),
    ('00000000-0000-0000-0000-00000000a003', 'geardrop', 'admin', true),
    ('00000000-0000-0000-0000-00000000a004', 'geardrop', 'editor', true),
    ('00000000-0000-0000-0000-00000000a005', 'geardrop', 'owner', false)
  $$,
  'staff keep their role at Gear Drop; active owners also run Oryvenne; the former owner does not'
);

select results_eq(
  $$
    select organization.slug, settings.store_name, settings.accept_orders
    from public.site_settings as settings
    join public.organizations as organization on organization.id = settings.organization_id
    order by organization.slug
  $$,
  $$values ('geardrop'::text, 'GEAR//DROP'::text, false), ('oryvenne'::text, 'Oryvenne'::text, false)$$,
  'Gear Drop keeps its settings; Oryvenne gets its own, closed to orders'
);

select results_eq(
  $$
    select organization.slug, count(*)::integer
    from public.order_enablement_checks as checks
    join public.organizations as organization on organization.id = checks.organization_id
    group by organization.slug order by organization.slug
  $$,
  $$values ('geardrop'::text, 4), ('oryvenne'::text, 4)$$,
  'each company has its own order checklist'
);

select results_eq(
  $$
    select action, organization_id is not null
    from public.audit_events
    where actor_user_id = '00000000-0000-0000-0000-00000000a001'
    order by action
  $$,
  $$values ('order.note_added'::text, true), ('staff.invited'::text, false)$$,
  'business events belong to Gear Drop; staff identity events to no company'
);

select results_eq(
  $$select order_number from public.orders$$,
  $$values ('GD-UPGRADE-1'::text)$$,
  'order numbers are unchanged'
);

select is(
  (select updated_at from public.products where slug = 'upgrade-top') <= (select created_at from public.organizations where slug = 'geardrop'),
  true,
  'the backfill touched no row: updated_at did not move'
);

select throws_ok(
  $$insert into public.products (category_id, slug, sku, name, tagline, description, price_cents)
    select id, 'no-company', 'no-company', 'No company', 't', 'd', 100 from public.categories where slug = 'upgrade-category'$$,
  '23502', null, 'after the upgrade a product must name its company'
);

select lives_ok(
  $$
    with oryvenne as (select id from public.organizations where slug = 'oryvenne'),
    category as (
      insert into public.categories (organization_id, slug, name, tagline, description)
      select id, 'upgrade-category', 'Upgrade', 't', 'd' from oryvenne returning id, organization_id
    )
    insert into public.products (organization_id, category_id, slug, sku, name, tagline, description, price_cents)
    select organization_id, id, 'upgrade-top', 'upgrade-top', 'Same slug', 't', 'd', 100 from category
  $$,
  'slugs and SKUs are unique per company, so Oryvenne may reuse them'
);

select throws_ok(
  $$
    insert into public.bundle_items (bundle_id, product_id, quantity)
    select bundle.id, product.id, 1
    from public.bundles as bundle, public.products as product
    where bundle.slug = 'upgrade-bundle'
      and product.organization_id = (select id from public.organizations where slug = 'oryvenne')
  $$,
  '23503', null, 'a Gear Drop bundle cannot hold an Oryvenne product'
);

select throws_ok(
  $$update public.products set organization_id = (select id from public.organizations where slug = 'oryvenne') where slug = 'upgrade-deck'$$,
  '55000', 'GD_ORGANIZATION_IMMUTABLE', 'no row moves to another company'
);

select results_eq(
  $$select organization_id = (select id from public.organizations where slug = 'geardrop') from public.storefront_daily_events$$,
  $$values (true)$$,
  'funnel counters belong to the Gear Drop shop'
);

select * from finish();
rollback;
